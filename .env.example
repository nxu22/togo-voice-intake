# Togo Voice Intake — environment template
# Copy to .env and fill in. Never commit .env.

# --- LiveKit (worker connects to LiveKit Cloud / self-hosted) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Model providers ---
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=

# Claude model used for the conversation (Haiku-class, low latency)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Cartesia voice id for TTS
CARTESIA_VOICE_ID=

# --- Post-call delivery ---
# n8n webhook that fans out to email + Airtable CRM
N8N_WEBHOOK_URL=
# Payloads that fail all retries are written here as JSON so no lead is lost
FAILED_WEBHOOKS_DIR=failed_webhooks

# --- Rate limiting (limits.py) ---
# SQLite file holding call counters
RATE_LIMIT_DB_PATH=limits.db
# Counters reset at midnight in this timezone
RATE_LIMIT_TIMEZONE=America/Winnipeg
# Layer 1: daily caps across all callers
DAILY_CALL_CAP=50
DAILY_SPEND_CAP_USD=10.00
ESTIMATED_COST_PER_MINUTE_USD=0.08
# Layer 2: per-caller cap, same caller ID per day
PER_CALLER_DAILY_CAP=3
# Layer 3: hard per-call limit; agent forces readback + goodbye at this point
MAX_CALL_SECONDS=600
